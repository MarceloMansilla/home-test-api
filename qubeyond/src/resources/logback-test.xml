<?xml version="1.0" encoding="UTF-8"?>
<configuration>
 
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
  
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/karate.log</file>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>    
   
    <!-- INFO by default, on purpose. At DEBUG the com.intuit logger writes every
         request and response - headers included - to the console and to
         target/karate.log, a file that outlives the run and is routinely archived
         as a CI artifact. Logback initialises before karate-config.js can speak,
         so the safe level has to be the one written here.

         karate-config.js raises this to DEBUG for environments whose YAML sets
         config.debug: true, which keeps that flag the single switch. Override for
         one run with -Dkarate.log.level=DEBUG. -->
    <logger name="com.intuit" level="${karate.log.level:-INFO}"/>
   
    <root level="info">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>
  
</configuration>